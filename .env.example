# Environment Configuration for AI Agent Platform

# ============= NODE ENVIRONMENT =============
NODE_ENV=production

# ============= API CONFIGURATION =============
API_HOST=0.0.0.0
API_PORT=5000
API_LOG_LEVEL=info

# ============= DATABASE =============
DATABASE_URL=postgresql://aiplatform:password@localhost:5432/ai_agent_platform
DATABASE_POOL_SIZE=20
DATABASE_STATEMENT_CACHE_SIZE=100

# ============= CACHE =============
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400

# ============= MESSAGE QUEUE =============
RABBITMQ_URL=amqp://aiplatform:password@localhost:5672/
RABBITMQ_QUEUE_DURABLE=true

# ============= EXTERNAL APIs =============
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TIMEOUT_SECONDS=30

# ============= INSTAGRAM / META =============
INSTAGRAM_APP_ID=your_app_id
INSTAGRAM_APP_SECRET=your_app_secret
INSTAGRAM_VERIFY_TOKEN=your_verify_token
INSTAGRAM_API_VERSION=v18.0

# ============= TWITTER / X =============
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_BEARER_TOKEN=your_bearer_token

# ============= HUBSPOT =============
HUBSPOT_API_KEY=your_hubspot_api_key
HUBSPOT_VERIFY_TOKEN=your_hubspot_verify_token

# ============= SALESFORCE =============
SALESFORCE_CLIENT_ID=your_client_id
SALESFORCE_CLIENT_SECRET=your_client_secret
SALESFORCE_INSTANCE_URL=https://your-instance.salesforce.com

# ============= SECURITY =============
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============= CORS =============
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============= MONITORING =============
SENTRY_DSN=https://your-sentry-dsn-here
LOG_LEVEL=INFO

# ============= FEATURE FLAGS =============
ENABLE_CRM_SYNC=true
ENABLE_AI_SCORING=true
ENABLE_AUTO_POSTING=true
ENABLE_WEBHOOKS=true
